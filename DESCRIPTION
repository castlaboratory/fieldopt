Package: fieldopt
Title: Field-Survey Design under Real Field Cost
Version: 0.1.0
Authors@R: c(
    person("André", "Leite", , "leite@castlab.org", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-4718-9766")),
    person("Raydonal", "Ospina", , "raydonal@castlab.org", role = "aut",
           comment = c(ORCID = "0000-0002-9884-9090")),
